{
  "id": "io.github.brutalbirdie.ptsdiscordvoicebot",
  "version": "0.3.0",
  "title": "PTS Discord Bot",
  "author": "BrutalBirdie",
  "tagline": "Discord bot with a web UI to schedule voice and message tasks",
  "icon": "file://logo.png",
  "healthCheckPath": "/healthz",
  "configurePath": "/admin",
  "httpPort": 8000,
  "memoryLimit": 536870912,
  "minBoxVersion": "10.0.1",
  "checklist": {
    "set-discord-token": {
      "message": "Set DISCORD_TOKEN in /app/data/env.sh and switch on the Server Members intent of the bot in the Discord Developer Portal. Restart the app after editing env.sh."
    },
    "set-admins": {
      "message": "Set admins: add Cloudron usernames to BOT_ADMINS or Cloudron groups to BOT_ADMIN_GROUP in /app/data/env.sh."
    }
  },
  "addons": {
    "localstorage": {},
    "postgresql": {},
    "oidc": {
      "loginRedirectUri": "/auth/callback",
      "logoutRedirectUri": "/",
      "tokenSignatureAlgorithm": "RS256"
    }
  },
  "manifestVersion": 2,
  "description": "file://DESCRIPTION.md",
  "changelog": "file://CHANGELOG",
  "postInstallMessage": "file://POSTINSTALL.md",
  "website": "https://github.com/BrutalBirdie/pts-discord-bot",
  "packagerName": "James Smith",
  "packagerUrl": "https://github.com/BrutalBirdie/pts-discord-bot",
  "iconUrl": "https://github.com/BrutalBirdie/pts-discord-bot/blob/master/logo.png?raw=true",
  "tags": [
    "chat"
  ],
  "packageUrl": "https://github.com/BrutalBirdie/pts-discord-bot",
  "mediaLinks": [
    "https://example.com/screenshot.png"
  ]
}

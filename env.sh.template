# Restart the app after editing this file.

# Bot token from https://discord.com/developers/applications > your app > Bot
export DISCORD_TOKEN="${DISCORD_TOKEN:-}"

# Cloudron usernames and group names that see the Admin page, comma or space separated.
export BOT_ADMINS="${BOT_ADMINS:-}"
export BOT_ADMIN_GROUP="${BOT_ADMIN_GROUP:-}"

# Lists server members. Needs the privileged Server Members intent in the Developer Portal.
# Without it the bot connects anyway, member lists stay empty.
export BOT_MEMBERS_INTENT="true"

# Lets tasks react to keywords in messages. Needs the privileged Message Content intent.
export BOT_MESSAGE_CONTENT_INTENT="true"

# Shows who is online in the Control Room member list. Needs the privileged Presence intent.
export BOT_PRESENCE_INTENT="true"

# Discord login for members of the servers the bot is in, an admin approves each one under Admin > Access.
# Client Secret from https://discord.com/developers/applications > your app > OAuth2. Add the redirect
# https://<this app's domain>/auth/discord/callback there. Empty turns Discord login off.
export DISCORD_CLIENT_SECRET="${DISCORD_CLIENT_SECRET:-}"
